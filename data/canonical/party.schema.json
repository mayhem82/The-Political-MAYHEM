{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "party.schema.json",
  "title": "Political MAYHEM Party",
  "type": "object",
  "required": ["party_id", "name", "jurisdiction", "observations", "created_at", "updated_at"],
  "properties": {
    "party_id": {"type": "string"},
    "name": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "abbreviation": {"type": ["string", "null"]},
    "actor_ids": {"type": "array", "items": {"type": "string"}},
    "observations": {"type": "array", "items": {"type": "string"}},
    "state_refs": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
