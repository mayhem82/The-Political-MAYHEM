{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "political-cycle.schema.json",
  "title": "Political MAYHEM Political Cycle",
  "type": "object",
  "required": ["cycle_id", "jurisdiction", "cycle_type", "status", "created_at", "updated_at"],
  "properties": {
    "cycle_id": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "cycle_type": {"type": "string"},
    "name": {"type": "string"},
    "status": {"enum": ["PLANNED", "ACTIVE", "OUTCOME_RECONCILIATION", "CLOSED"]},
    "start_date": {"type": ["string", "null"], "format": "date"},
    "end_date": {"type": ["string", "null"], "format": "date"},
    "contest_ids": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
