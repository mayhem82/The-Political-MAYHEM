        {"stat_id":"two_candidate_or_two_party_percent","label":"TCP / DIVISION 2PP","unit":"PERCENT","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_HOUSE_150_OF_150_DIVISION_2PP_PLUS_5_CANDIDATE_TCP_RECORDS_LOADED"},
        {"stat_id":"margin_percent","label":"MARGIN","unit":"VOTES_OR_PERCENTAGE_POINTS_AS_PUBLISHED","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_HOUSE_CANDIDATE_SPECIFIC_EXPANDING"},
