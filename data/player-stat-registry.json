        {"stat_id":"verified_events","label":"VERIFIED","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"distinct_sources","label":"SOURCES","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"role_changes","label":"ROLE CHANGES","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"contradictions","label":"CONTRADICTIONS","unit":"COUNT","source":"PLAYER_FORM_AND_CONTRADICTION_LEDGER","availability":"LOADED"},
        {"stat_id":"target_effects","label":"TARGET EFFECTS","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"form","label":"FORM","unit":"STATE","source":"PLAYER_FORM_LEDGER","availability":"LOADED"},
