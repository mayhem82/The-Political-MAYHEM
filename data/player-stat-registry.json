{
  "registry_id": "POLITICAL-PLAYER-STAT-REGISTRY-006",
  "status": "EXPANDING",
  "purpose": "Define political-player statistics in native political units while retaining the sports translation layer for legibility.",
  "rules": {
    "no_synthetic_composite_player_score": true,
    "zero_requires_observed_zero": true,
    "missing_data_is_not_zero": true,
    "inference_is_not_observation": true,
    "source_lineage_required": true,
    "jurisdiction_context_required": true,
    "statistics_must_remain_comparable_within_their_native_unit": true,
    "aggregate_other_vote_must_not_be_attributed_to_an_individual_player": true,
    "two_party_preferred_must_not_be_labelled_two_candidate_preferred_in_nonclassic_contests": true,
    "historical_election_party_must_not_be_rewritten_by_current_affiliation": true,
    "current_member_replacement_must_not_inherit_predecessor_election_stats": true,
    "senate_group_first_preference_must_not_be_labelled_individual_primary_vote": true,
    "senate_replacement_must_not_inherit_predecessor_election_stats": true,
    "senate_replacement_must_not_inherit_predecessor_elected_record": true,
    "finals_history_preserves_team_at_time_of_contest": true,
    "finals_history_preserves_jurisdiction_and_contest": true,
    "career_finals_total_requires_complete_historical_coverage": true,
    "partial_history_must_be_labelled_known_finals_not_career_total": true,
    "missing_historical_contests_must_not_be_rendered_as_losses_or_zero": true
  },
  "groups": [
    {
      "group_id": "STRUCTURAL",
      "public_label": "STRUCTURAL",
      "stats": [
        {"stat_id":"competition","label":"COMPETITION","unit":"CATEGORY","source":"CURRENT_PARLIAMENTARY_ROSTER","availability":"LOADED"},
        {"stat_id":"team","label":"TEAM","unit":"CATEGORY","source":"CURRENT_PARLIAMENTARY_ROSTER","availability":"LOADED"},
        {"stat_id":"chamber","label":"CHAMBER","unit":"CATEGORY","source":"CURRENT_PARLIAMENTARY_ROSTER","availability":"LOADED"},
        {"stat_id":"electorate","label":"ELECTORATE / STATE","unit":"CATEGORY","source":"CURRENT_PARLIAMENTARY_ROSTER","availability":"LOADED"}
      ]
    },
    {
      "group_id": "FORWARD_INTELLIGENCE",
      "public_label": "CURRENT PERFORMANCE",
      "stats": [
        {"stat_id":"ledger_events","label":"LEDGER EVENTS","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"verified_events","label":"VERIFIED","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"distinct_sources","label":"SOURCES","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"role_changes","label":"ROLE CHANGES","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"contradictions","label":"CONTRADICTIONS","unit":"COUNT","source":"PLAYER_FORM_AND_CONTRADICTION_LEDGER","availability":"LOADED"},
        {"stat_id":"target_effects","label":"TARGET EFFECTS","unit":"COUNT","source":"INTELLIGENCE_EVENT_LEDGER","availability":"LOADED"},
        {"stat_id":"form","label":"FORM","unit":"STATE","source":"PLAYER_FORM_LEDGER","availability":"LOADED"},
        {"stat_id":"trend","label":"TREND","unit":"STATE","source":"PLAYER_FORM_LEDGER","availability":"LOADED"}
      ]
    },
    {
      "group_id": "ELECTORAL_PERFORMANCE",
      "public_label": "ELECTORAL PERFORMANCE",
      "stats": [
        {"stat_id":"primary_vote_percent","label":"HOUSE PRIMARY VOTE","unit":"PERCENT","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_HOUSE_CURRENT_PLAYERS_150_OF_150_CANDIDATE_SPECIFIC_RESULTS_LOADED"},
        {"stat_id":"two_candidate_or_two_party_percent","label":"HOUSE TCP / DIVISION 2PP","unit":"PERCENT","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_HOUSE_CURRENT_PLAYERS_150_OF_150_CANDIDATE_SPECIFIC_TCP_RESULTS_LOADED"},
        {"stat_id":"margin_percent","label":"HOUSE MARGIN","unit":"VOTES_OR_PERCENTAGE_POINTS_AS_PUBLISHED","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_HOUSE_CURRENT_PLAYERS_150_OF_150_CANDIDATE_SPECIFIC_RESULTS_LOADED"},
        {"stat_id":"swing_points","label":"HOUSE SWING","unit":"PERCENTAGE_POINTS","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_HOUSE_CURRENT_PLAYERS_150_OF_150_CANDIDATE_SPECIFIC_RESULTS_LOADED"},
        {"stat_id":"senate_elected_order","label":"SENATE ELECTED ORDER","unit":"ORDINAL_WITHIN_STATE_EVENT","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_SENATE_69_OF_76_CURRENT_PLAYERS_DIRECT_ELECTED_RECORDS_LOADED"},
        {"stat_id":"senate_group_first_preference_percent","label":"SENATE GROUP FIRST PREFERENCE","unit":"PERCENT_OF_STATE_FORMAL_VOTES","source":"ELECTORAL_AUTHORITY_RESULT","availability":"FEDERAL_SENATE_69_OF_76_CURRENT_PLAYERS_GROUP_CONTEXT_LOADED"}
      ],
      "scope_notes": [
        "149 current House players are reconciled to their 2025 Federal Election winning-candidate record.",
        "David Farley is reconciled to the 2026 Farrer By-election; Sussan Ley's 2025 Farrer winning record remains historical and is not attributed to Farley.",
        "69 current Senators are reconciled directly to their 2025 or 2022 elected-Senator record and corresponding state/group first-preference context.",
        "Seven current Senators are later replacements or otherwise do not match a 2025/2022 elected-Senator record in the current snapshot; predecessor electoral records are not inherited.",
        "A Senate group first-preference percentage is team/group context and is never represented as the individual Senator's primary vote.",
        "State/territory candidate-level electoral statistics remain a separate expansion layer."
      ]
    },
    {
      "group_id": "FINALS_HISTORY",
      "public_label": "FINALS HISTORY",
      "stats": [
        {"stat_id":"known_finals","label":"KNOWN FINALS","unit":"COUNT","source":"SOURCE_BACKED_ELECTORAL_CONTEST_HISTORY","availability":"PARTIAL_HISTORY"},
        {"stat_id":"known_wins","label":"KNOWN WINS","unit":"COUNT","source":"SOURCE_BACKED_ELECTORAL_CONTEST_HISTORY","availability":"PARTIAL_HISTORY"},
        {"stat_id":"known_losses","label":"KNOWN LOSSES","unit":"COUNT","source":"SOURCE_BACKED_ELECTORAL_CONTEST_HISTORY","availability":"PARTIAL_HISTORY"},
        {"stat_id":"final_team","label":"TEAM AT FINAL","unit":"CATEGORY_PER_CONTEST","source":"ELECTORAL_AUTHORITY_RESULT","availability":"PARTIAL_HISTORY"},
        {"stat_id":"final_result","label":"FINAL RESULT","unit":"WIN_LOSS_OR_UNRESOLVED","source":"ELECTORAL_AUTHORITY_RESULT","availability":"PARTIAL_HISTORY"},
        {"stat_id":"career_finals","label":"CAREER FINALS","unit":"COUNT","source":"SOURCE_BACKED_ELECTORAL_CONTEST_HISTORY","availability":"WITHHELD_UNTIL_HISTORY_COMPLETE"}
      ],
      "scope_notes": [
        "A final is an election contest in which the player was a candidate on the ballot.",
        "Each history row preserves the contest, jurisdiction, team/party represented at that contest and verified election result.",
        "Current federal electoral datasets provide only partial career history; therefore the UI must say KNOWN FINALS rather than CAREER FINALS until historical ingestion is complete.",
        "A player changing parties does not rewrite the team recorded for an earlier final.",
        "A missing historical contest is unknown, not a loss and not a zero."
      ]
    },
    {
      "group_id": "PARLIAMENTARY_ACTIVITY",
      "public_label": "PARLIAMENTARY ACTIVITY",
      "stats": [
        {"stat_id":"hansard_contributions","label":"HANSARD CONTRIBUTIONS","unit":"COUNT","source":"PRIMARY_PARLIAMENT","availability":"INGESTION_PENDING"},
        {"stat_id":"questions","label":"QUESTIONS","unit":"COUNT","source":"PRIMARY_PARLIAMENT","availability":"INGESTION_PENDING"},
        {"stat_id":"motions","label":"MOTIONS","unit":"COUNT","source":"PRIMARY_PARLIAMENT","availability":"INGESTION_PENDING"},
        {"stat_id":"bills","label":"BILLS","unit":"COUNT","source":"PRIMARY_PARLIAMENT","availability":"INGESTION_PENDING"},
        {"stat_id":"committee_roles","label":"COMMITTEE ROLES","unit":"COUNT","source":"PRIMARY_PARLIAMENT","availability":"INGESTION_PENDING"},
        {"stat_id":"division_participation","label":"DIVISION PARTICIPATION","unit":"COUNT_OR_PERCENT","source":"PRIMARY_PARLIAMENT","availability":"INGESTION_PENDING"}
      ]
    }
  ]
}
