      "VOTING_EVENT",
      "COUNT_UPDATE",
      "DECLARATION_OR_FORMATION_EVENT"
    ],
    "LEGISLATIVE": [
      "INTRODUCTION",
      "AMENDMENT",
      "COMMITTEE_STAGE",
      "PARTY_ROOM_POSITION",
      "CROSSBENCH_NEGOTIATION",
      "PROCEDURAL_MOVE",
      "DIVISION_OR_VOTE",
      "WITHDRAWAL",
      "PASSAGE_STATUS_EVENT"
    ]
  },
  "event_fields": [
    "event_id",
    "contest_id",
    "cycle_id",
    "competition_class",
    "event_type",
    "occurred_at",
    "captured_at",
    "party_ids",
    "actor_ids",
