{
  "ledger_id": "POLITICAL-MAYHEM-COMPETITION-EVENTS-001",
  "status": "ACTIVE",
  "rules": {
    "event_requires_registered_contest": true,
    "event_requires_source_lineage": true,
    "event_is_observation_before_inference": true,
