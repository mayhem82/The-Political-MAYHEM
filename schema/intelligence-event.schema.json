{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayhem82.github.io/The-Political-MAYHEM/schema/intelligence-event.schema.json",
  "title": "Political MAYHEM Intelligence Event",
  "type": "object",
  "required": ["event_id", "captured_at", "event_type", "signal_state", "source_snapshot_id"],
  "properties": {
    "event_id": {"type": "string"},
    "contest_id": {"type": ["string", "null"]},
    "cycle_id": {"type": ["string", "null"]},
    "party_id": {"type": ["string", "null"]},
    "actor_id": {"type": ["string", "null"]},
    "source_snapshot_id": {"type": "string"},
    "record_id": {"type": ["string", "null"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "event_time": {"type": ["string", "null"], "format": "date-time"},
    "checkpoint": {"type": ["string", "null"]},
    "event_type": {"enum": ["ADDED_RECORD", "REMOVED_RECORD", "FIELD_CHANGED", "SIGNAL_CREATED", "SIGNAL_REVERSED", "CONFLICT_CREATED", "CONFLICT_RESOLVED", "PROJECTION_CHANGED", "PROJECTION_FROZEN", "OUTCOME_RECORDED", "ACTOR_STATE_CHANGED", "PARTY_STATE_CHANGED"]},
    "evidence_state": {"enum": ["VERIFIED", "UNVERIFIED", "CONTRADICTED", "SIGNAL", "UNKNOWN"]},
    "signal_state": {"enum": ["OBSERVED", "POSSIBLE_SIGNAL", "PROBABLE_SIGNAL", "CORROBORATED_SIGNAL", "CONFIRMED_FACT", "CONFLICTING", "EXCLUDED", "UNKNOWN"]},
    "source_class": {"type": "string"},
    "source_id": {"type": ["string", "null"]},
    "before": {},
    "after": {},
    "claim": {"type": ["string", "null"]},
    "observed_behaviour": {"type": ["string", "null"]},
    "direct_actor_statement": {"type": ["string", "null"]},
    "inference": {"type": ["string", "null"]},
    "inference_class": {"enum": ["NONE", "BEHAVIOURAL", "PSYCHOLOGICAL_CONDITION", "CAUSAL_HYPOTHESIS", "STRUCTURAL", "OTHER"]},
    "conflict_ids": {"type": "array", "items": {"type": "string"}},
    "projection_effect": {"enum": ["NO_EFFECT", "CONFIDENCE_CHANGE", "RANKING_CHANGE", "OUTCOME_SELECTION_CHANGE", "ABSTAIN_INSUFFICIENT_EVIDENCE"]},
    "information_advantage": {"enum": ["NONE", "POSSIBLE", "CORROBORATED", "DEMONSTRATED"]},
    "frozen": {"type": "boolean"}
  },
  "additionalProperties": true
}
