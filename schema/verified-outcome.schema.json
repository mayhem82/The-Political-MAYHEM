{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayhem82.github.io/The-Political-MAYHEM/schema/verified-outcome.schema.json",
  "title": "Political MAYHEM Verified Outcome",
  "type": "object",
  "required": ["outcome_id", "contest_id", "cycle_id", "outcome_type", "outcome", "verification_state", "source_snapshot_ids", "recorded_at"],
  "properties": {
    "outcome_id": {"type": "string"},
    "contest_id": {"type": "string"},
    "cycle_id": {"type": "string"},
    "outcome_type": {"enum": ["ELECTION_RESULT", "SEAT_RESULT", "GOVERNMENT_FORMATION", "LEADERSHIP_RESULT", "LEGISLATIVE_RESULT", "REFERENDUM_RESULT", "APPOINTMENT", "RESIGNATION", "REMOVAL", "OTHER"]},
    "outcome": {},
    "effective_at": {"type": ["string", "null"], "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "verification_state": {"enum": ["VERIFIED", "PROVISIONAL", "CONTESTED", "UNKNOWN"]},
    "source_snapshot_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "primary_authority_source_snapshot_id": {"type": ["string", "null"]},
    "supersedes_outcome_id": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
